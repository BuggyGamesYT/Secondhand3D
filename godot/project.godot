; Engine configuration file.
; Secondhand 3D (c) 2026 Buggy Games YT. All rights reserved.

config_version=5

[application]

config/name="Secondhand 3D"
config/description="A glitch horror game by Buggy Games YT."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[audio]

driver/output_latency=30

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=256
lights_and_shadows/positional_shadow/atlas_size.mobile=256
gl_compatibility/driver.android="opengl3"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
limits/opengl/max_renderable_lights=8

[shader_globals]

hemi_sky={
"type": "vec3",
"value": Vector3(0.4, 0.45, 0.5)
}
hemi_ground={
"type": "vec3",
"value": Vector3(0.15, 0.12, 0.1)
}
